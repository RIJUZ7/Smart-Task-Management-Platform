# ==============================================================================
# TASKFORGE Environment Configuration Template
# ==============================================================================

# Application Profile (dev | prod | test)
# 'dev' uses local in-memory H2 with PostgreSQL syntax emulation (zero external setup)
# 'prod' uses standard PostgreSQL instance
SPRING_PROFILES_ACTIVE=prod

# Server Port
SERVER_PORT=8080

# PostgreSQL Production Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskforge
DB_USER=taskforge
DB_PASSWORD=taskforge_secret_2026

# JWT Authentication
JWT_SECRET=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b
JWT_EXPIRATION_MS=86400000

# Frontend Dev Proxy
VITE_API_BASE_URL=/api
